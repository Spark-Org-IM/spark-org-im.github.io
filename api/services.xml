<?xml version="1.0" encoding="UTF-8"?>
<!-- SparkOrg · Services API（由 scripts/generate-api.mjs 从 services.toml 生成，请勿手工编辑） -->
<services home="HOME" home_domain="sparkorg.dpdns.org">
  <service key="HOME" domain="sparkorg.dpdns.org">
    <zh>主页</zh>
    <en>Home</en>
    <desc_zh>SparkOrg 主站入口</desc_zh>
    <desc_en>SparkOrg main site</desc_en>
  </service>
  <service key="FORUM" domain="forum.sparkorg.dpdns.org">
    <zh>论坛</zh>
    <en>Forum</en>
    <desc_zh>社区交流与讨论</desc_zh>
    <desc_en>Community discussion forum</desc_en>
  </service>
  <service key="GIT" domain="git.sparkorg.dpdns.org">
    <zh>Git 服务</zh>
    <en>Git</en>
    <desc_zh>代码托管与仓库服务</desc_zh>
    <desc_en>Source code hosting service</desc_en>
  </service>
  <service key="STATUS" domain="status.sparkorg.dpdns.org">
    <zh>状态页</zh>
    <en>Status</en>
    <desc_zh>各服务的运行状态与公告</desc_zh>
    <desc_en>Service status and announcements</desc_en>
  </service>
  <service key="CLOUD_ST" domain="cloud.sparkorg.dpdns.org">
    <zh>Fdroid 镜像源</zh>
    <en>Fdroid Source</en>
    <desc_zh>发布组织的Android开源应用程序和我们找到的其他好用开源Android应用程序(不定时更新,不过可以发邮件提醒更新)</desc_zh>
    <desc_en>Open-source Android apps released by our organization and other useful open-source Android apps we've found (updated irregularly; email us to be reminded about updates)</desc_en>
  </service>
  <service key="FDROID" domain="fdroid.sparkorg.dpdns.org">
    <zh>FDROID</zh>
    <en>FDROID</en>
    <desc_zh>服务 FDROID</desc_zh>
    <desc_en>Service FDROID</desc_en>
  </service>
</services>
